# 复制本文件为 .env 并填入你的 LLM 配置。
# 项目用 openai SDK 作为 HTTP 通道，任何 OpenAI 兼容的服务都能用。
# 统一用厂商中立的 LLM_* 变量（也兼容旧的 ZHIPU_* / GLM_*）。

# ---- 方案 A：DeepSeek（便宜、不限流、指令跟随好）----
LLM_API_KEY=sk-your_deepseek_key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 方案 B：智谱 GLM 常规 API ----
# LLM_API_KEY=你的智谱key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_MODEL=glm-4.5

# ---- 方案 C：智谱 GLM Coding Plan（OpenAI 协议）----
# LLM_API_KEY=你的coding_plan_key
# LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# LLM_MODEL=glm-4.5

# ---- 方案 D：OpenAI ----
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
